# Employee Management System - Apache Configuration
# Enable if using Apache web server

RewriteEngine On

# Redirect API requests to api.php
RewriteRule ^api/(.*)$ api.php/$1 [QSA,L]

# Serve server dashboard as default index
DirectoryIndex server_index.html index.html

# Enable CORS for API requests
<FilesMatch "\.(php)$">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
</FilesMatch>

# Handle OPTIONS requests
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ api.php [QSA,L]

# Security headers
<FilesMatch "\.(html|htm|js|css)$">
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
</FilesMatch>

# Cache static assets
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg)$">
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
</FilesMatch>